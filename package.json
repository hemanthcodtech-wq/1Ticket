{
  "name": "1ticket",
  "version": "1.0.0",
  "description": "1ticket - Modern Event Ticketing Platform with React, Express and Neon PostgreSQL",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^10.1.0",
    "nodemon": "^3.1.14",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
